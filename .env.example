# ==============================================================================
# AffiliatePilot AI - Production Environment Variables
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production
BASE_URL=http://localhost:3000

# 1. Shopee Open Platform (Official Affiliate GraphQL API)
# สมัครที่ https://affiliate.shopee.co.th/open_api
SHOPEE_APP_ID=15349720148
SHOPEE_APP_SECRET=your_shopee_app_secret_here
SHOPEE_GRAPHQL_ENDPOINT=https://open-api.affiliate.shopee.co.th/graphql

# 2. Telegram Bot Configuration (24/7 Webhook & Broadcast)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here
TELEGRAM_WEBHOOK_SECRET=affiliate_pilot_secure_secret_2026

# 3. Google Gemini 2.5 Flash API (AI Copywriter & Shopping Assistant)
# ขอรับฟรีที่ https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Facebook Page Graph API (Zero-Suppression: Photo + First Comment)
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# 5. X (Twitter) API v2 (Shadowban-Free: Main Tweet + Thread Reply)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here

# 6. Webhook Relay (ทางเลือก: Make.com หรือ n8n Webhook)
# หากระบุ URL ระบบจะส่ง JSON Payload ไปยัง Webhook นี้แทนการเรียก API โซเชียลโดยตรง
WEBHOOK_RELAY_URL=
